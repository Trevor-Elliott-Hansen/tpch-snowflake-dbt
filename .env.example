# =============================================================================
# .env.example  —  copy to .env and fill in your own credentials
# =============================================================================
# This file is committed; .env is git-ignored.
# Load with `source .env` (bash/zsh) or `direnv` / `dotenv` in your toolchain.
# =============================================================================

# --- Snowflake connection (required) -----------------------------------------
SNOWFLAKE_ACCOUNT=xy12345.us-east-1     # your Snowflake account locator
SNOWFLAKE_USER=your_user
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_WAREHOUSE=TRANSFORMING
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_SCHEMA=DBT_DEV                # default schema for dev target

# --- Auth: key-pair (used by both dev and prod targets) ----------------------
# Snowflake enforces MFA on password logins for self-service accounts, so
# programmatic access (dbt, CI) authenticates with a key-pair. See README
# "Configure dbt profile" for key generation and registration.
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/.ssh/snowflake_rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=       # only if the key is passphrase-protected

# --- MetricFlow CLI (required for `mf` commands; see README §4a) --------------
# The mf CLI on dbt-core 1.11 can resolve profiles to its bundled tutorial
# project instead of ~/.dbt/ unless this is set explicitly.
DBT_PROFILES_DIR=/absolute/path/to/home/.dbt
